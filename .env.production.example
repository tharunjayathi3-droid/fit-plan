# Point this domain's DNS A/AAAA records at the deployment server.
FITPLAN_DOMAIN=fitplan.example.com

# Use a long, unique password made from URL-safe characters (letters, numbers, hyphens).
POSTGRES_DB=fitplan
POSTGRES_USER=fitplan
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Optional; leave empty to run without AI Coach.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
