generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  FEMALE
  MALE
  INTERSEX
  PREFER_NOT_TO_SAY
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum GoalCategory {
  MUSCLE_GAIN
  FAT_LOSS
  WEIGHT_LOSS
  WEIGHT_GAIN
  RECOMPOSITION
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTREMELY_ACTIVE
}

enum DietType {
  NO_RESTRICTION
  VEGETARIAN
  VEGAN
  EGGETARIAN
  CUSTOM
}

enum RestrictionType {
  DISLIKE
  CANNOT_EAT
  ALLERGY
  INTOLERANCE
}

enum RestrictionSeverity {
  MILD
  MODERATE
  SEVERE
}

enum FoodCategory {
  FRUIT
  VEGETABLE
  GRAIN
  PROTEIN
  DAIRY
  LEGUME
  NUT_SEED
  OIL_CONDIMENT
  BEVERAGE
  OTHER
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MovementPattern {
  SQUAT
  HINGE
  HORIZONTAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PUSH
  VERTICAL_PULL
  LUNGE_CARRY
  ROTATION
  CARDIO
  OTHER
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

enum ProgressMetric {
  BODY_WEIGHT
  WAIST
  CHEST
  ARM
  LEG
  HIP
  BODY_FAT
  CUSTOM
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String?
  emailVerifiedAt      DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  profile              Profile?
  foodPreferences      UserFoodPreference[]
  foodRestrictions     FoodRestriction[]
  equipment            UserEquipment[]
  mealPlans            MealPlan[]
  workoutPlans         WorkoutPlan[]
  progressEntries      ProgressEntry[]
  exercisePerformances ExercisePerformance[]
  referenceImages      ReferenceImage[]
  conversations        ChatConversation[]
  sessions             Session[]
  availableFoods       UserAvailableFood[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Profile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  name               String
  dateOfBirth        DateTime?
  age                Int?
  sex                Sex?
  heightCm           Decimal?         @db.Decimal(6, 2)
  currentWeightKg    Decimal?         @db.Decimal(6, 2)
  targetWeightKg     Decimal?         @db.Decimal(6, 2)
  fitnessLevel       FitnessLevel?
  activityLevel      ActivityLevel?
  dietType           DietType         @default(NO_RESTRICTION)
  mealsPerDay        Int?
  preferredMealTimes Json?
  dailyBudget        Decimal?         @db.Decimal(10, 2)
  budgetCurrency     String?          @db.Char(3)
  workoutDaysPerWeek Int?
  workoutDurationMin Int?
  timezone           String?          @db.VarChar(64)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fitnessGoals       FitnessGoal[]
  physiqueGoals      PhysiqueGoal[]
  referenceImages    ReferenceImage[]

  @@index([fitnessLevel, activityLevel])
}

model FitnessGoal {
  id          String       @id @default(cuid())
  profileId   String
  category    GoalCategory
  label       String
  isPrimary   Boolean      @default(false)
  targetValue Decimal?     @db.Decimal(8, 2)
  targetUnit  String?      @db.VarChar(24)
  createdAt   DateTime     @default(now())
  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, category])
  @@index([profileId, isPrimary])
}

model FitnessGoalOption {
  id          String       @id @default(cuid())
  category    GoalCategory @unique
  label       String
  description String?
  createdAt   DateTime     @default(now())
}

model PhysiqueGoal {
  id          String   @id @default(cuid())
  profileId   String
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, isPrimary])
}

model PhysiqueGoalOption {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model DietPreference {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
}

model Food {
  id                   String               @id @default(cuid())
  name                 String
  slug                 String               @unique
  description          String?
  category             FoodCategory
  servingSize          Decimal              @db.Decimal(8, 2)
  servingUnit          String               @db.VarChar(24)
  calories             Decimal              @db.Decimal(8, 2)
  protein              Decimal              @db.Decimal(8, 2)
  carbohydrates        Decimal              @db.Decimal(8, 2)
  fat                  Decimal              @db.Decimal(8, 2)
  fiber                Decimal?             @db.Decimal(8, 2)
  estimatedCost        Decimal?             @db.Decimal(10, 2)
  currency             String?              @db.Char(3)
  isVegetarian         Boolean              @default(false)
  isVegan              Boolean              @default(false)
  containsEgg          Boolean              @default(false)
  allergens            String[]             @default([])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  preferences          UserFoodPreference[]
  availableFor         UserAvailableFood[]
  restrictions         FoodRestriction[]
  mealFoods            MealFood[]
  alternativesAsSource FoodAlternative[]    @relation("FoodAlternativeSource")
  alternativesAsTarget FoodAlternative[]    @relation("FoodAlternativeTarget")

  @@index([category, name])
  @@index([isVegan, isVegetarian])
}

model FoodRestriction {
  id        String               @id @default(cuid())
  userId    String
  foodId    String?
  name      String
  type      RestrictionType
  severity  RestrictionSeverity?
  notes     String?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  food      Food?                @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([foodId])
}

model UserFoodPreference {
  id        String   @id @default(cuid())
  userId    String
  foodId    String
  liked     Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([userId, foodId])
  @@index([foodId])
}

model UserAvailableFood {
  userId    String
  foodId    String
  quantity  Decimal? @db.Decimal(8, 2)
  unit      String?  @db.VarChar(24)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([userId, foodId])
  @@index([foodId])
}

model FoodAlternative {
  id                String   @id @default(cuid())
  sourceFoodId      String
  alternativeFoodId String
  rationale         String?
  createdAt         DateTime @default(now())
  sourceFood        Food     @relation("FoodAlternativeSource", fields: [sourceFoodId], references: [id], onDelete: Cascade)
  alternativeFood   Food     @relation("FoodAlternativeTarget", fields: [alternativeFoodId], references: [id], onDelete: Cascade)

  @@unique([sourceFoodId, alternativeFoodId])
  @@index([alternativeFoodId])
}

model Exercise {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  description          String?
  primaryMuscle        String
  secondaryMuscles     String[]              @default([])
  movementPattern      MovementPattern
  difficulty           ExerciseDifficulty
  instructions         String[]              @default([])
  safetyNotes          String[]              @default([])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  equipment            ExerciseEquipment[]
  workoutExercises     WorkoutExercise[]
  performances         ExercisePerformance[]
  alternativesAsSource ExerciseAlternative[] @relation("ExerciseAlternativeSource")
  alternativesAsTarget ExerciseAlternative[] @relation("ExerciseAlternativeTarget")

  @@index([primaryMuscle, movementPattern])
}

model ExerciseAlternative {
  id                    String   @id @default(cuid())
  sourceExerciseId      String
  alternativeExerciseId String
  rationale             String?
  createdAt             DateTime @default(now())
  sourceExercise        Exercise @relation("ExerciseAlternativeSource", fields: [sourceExerciseId], references: [id], onDelete: Cascade)
  alternativeExercise   Exercise @relation("ExerciseAlternativeTarget", fields: [alternativeExerciseId], references: [id], onDelete: Cascade)

  @@unique([sourceExerciseId, alternativeExerciseId])
  @@index([alternativeExerciseId])
}

model Equipment {
  id          String              @id @default(cuid())
  name        String              @unique
  slug        String              @unique
  description String?
  createdAt   DateTime            @default(now())
  users       UserEquipment[]
  exercises   ExerciseEquipment[]
}

model UserEquipment {
  userId      String
  equipmentId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([userId, equipmentId])
  @@index([equipmentId])
}

model ExerciseEquipment {
  exerciseId  String
  equipmentId String
  isRequired  Boolean   @default(true)
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([exerciseId, equipmentId])
  @@index([equipmentId])
}

model MealPlan {
  id                  String     @id @default(cuid())
  userId              String
  name                String
  status              PlanStatus @default(DRAFT)
  startsAt            DateTime?
  endsAt              DateTime?
  generatedAt         DateTime?
  version             Int        @default(1)
  targetCalories      Decimal?   @db.Decimal(8, 2)
  targetProtein       Decimal?   @db.Decimal(8, 2)
  targetCarbohydrates Decimal?   @db.Decimal(8, 2)
  targetFat           Decimal?   @db.Decimal(8, 2)
  currency            String?    @db.Char(3)
  totalEstimatedCost  Decimal?   @db.Decimal(10, 2)
  generationReason    String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals               Meal[]

  @@index([userId, status, createdAt])
}

model Meal {
  id                 String     @id @default(cuid())
  mealPlanId         String
  name               String
  type               MealType
  scheduledAt        DateTime?
  sortOrder          Int        @default(0)
  notes              String?
  caloriesTotal      Decimal?   @db.Decimal(8, 2)
  proteinTotal       Decimal?   @db.Decimal(8, 2)
  carbohydratesTotal Decimal?   @db.Decimal(8, 2)
  fatTotal           Decimal?   @db.Decimal(8, 2)
  estimatedCost      Decimal?   @db.Decimal(10, 2)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  mealPlan           MealPlan   @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  foods              MealFood[]

  @@index([mealPlanId, scheduledAt])
}

model MealFood {
  id            String   @id @default(cuid())
  mealId        String
  foodId        String
  quantity      Decimal  @db.Decimal(8, 2)
  unit          String   @db.VarChar(24)
  sortOrder     Int      @default(0)
  isCompleted   Boolean  @default(false)
  calories      Decimal  @db.Decimal(8, 2)
  protein       Decimal  @db.Decimal(8, 2)
  carbohydrates Decimal  @db.Decimal(8, 2)
  fat           Decimal  @db.Decimal(8, 2)
  fiber         Decimal  @db.Decimal(8, 2)
  estimatedCost Decimal? @db.Decimal(10, 2)
  currency      String?  @db.Char(3)
  createdAt     DateTime @default(now())
  meal          Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food          Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([mealId, sortOrder])
  @@index([foodId])
}

model WorkoutPlan {
  id               String       @id @default(cuid())
  userId           String
  name             String
  status           PlanStatus   @default(DRAFT)
  startsAt         DateTime?
  endsAt           DateTime?
  version          Int          @default(1)
  generationReason String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  days             WorkoutDay[]

  @@index([userId, status, createdAt])
}

model WorkoutDay {
  id                   String            @id @default(cuid())
  workoutPlanId        String
  name                 String
  scheduledOn          DateTime?
  sortOrder            Int               @default(0)
  completedAt          DateTime?
  startedAt            DateTime?
  durationMin          Int?
  estimatedDurationMin Int?
  createdAt            DateTime          @default(now())
  workoutPlan          WorkoutPlan       @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercises            WorkoutExercise[]

  @@index([workoutPlanId, scheduledOn])
}

model WorkoutExercise {
  id                   String       @id @default(cuid())
  workoutDayId         String
  exerciseId           String
  sortOrder            Int          @default(0)
  targetMuscle         String?
  instructionsOverride String?
  completedAt          DateTime?
  startedAt            DateTime?
  createdAt            DateTime     @default(now())
  workoutDay           WorkoutDay   @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exercise             Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets                 WorkoutSet[]

  @@index([workoutDayId, sortOrder])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  setNumber         Int
  targetRepsMin     Int?
  targetRepsMax     Int?
  targetWeightKg    Decimal?        @db.Decimal(7, 2)
  restSeconds       Int?
  completedReps     Int?
  completedWeightKg Decimal?        @db.Decimal(7, 2)
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, setNumber])
  @@index([completedAt])
}

model ProgressEntry {
  id         String         @id @default(cuid())
  userId     String
  metric     ProgressMetric
  value      Decimal        @db.Decimal(9, 3)
  unit       String         @db.VarChar(24)
  recordedAt DateTime       @default(now())
  notes      String?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, metric, recordedAt])
}

model ExercisePerformance {
  id           String   @id @default(cuid())
  userId       String
  exerciseId   String
  performedAt  DateTime @default(now())
  sets         Int?
  reps         Int?
  weightKg     Decimal? @db.Decimal(7, 2)
  durationSecs Int?
  notes        String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([userId, exerciseId, performedAt])
}

model ReferenceImage {
  id         String   @id @default(cuid())
  userId     String
  profileId  String?
  storageKey String
  url        String?
  mimeType   String
  sizeBytes  Int
  altText    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile    Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String
  metadata       Json?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
